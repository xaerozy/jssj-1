<view class="container">
  <!-- 顶部用户信息栏 -->
  <view class="user-header">
    <view class="user-info">
      <view class="welcome-text">欢迎您，</view>
      <view class="user-details">
        <text class="user-name">{{currentUser.name}}</text>
        <text class="user-role-badge">{{currentUser.role}}</text>
      </view>
    </view>
    <button class="switch-btn" hover-class="hover-btn" bindtap="onLogout">切换账号 ⇄</button>
  </view>

  <!-- 统计信息区 -->
  <view class="stats-row">
    <view class="stat-box" bindtap="onSelectFilter" data-tab="pending">
      <view class="stat-num color-warning">{{stats.pendingCount}}</view>
      <view class="stat-label">待我确认</view>
    </view>
    <view class="stat-box" bindtap="onSelectFilter" data-tab="all">
      <view class="stat-num color-primary">{{stats.totalCount}}</view>
      <view class="stat-label">全部比价单</view>
    </view>
    <view class="stat-box" bindtap="onSelectFilter" data-tab="approved">
      <view class="stat-num color-success">{{stats.approvedCount}}</view>
      <view class="stat-label">已归档通过</view>
    </view>
  </view>

  <!-- 🔍 智能多维搜索栏 -->
  <view class="search-bar-container" style="background-color:#ffffff; padding:16rpx 24rpx; border-radius:16rpx; margin-bottom:24rpx; box-shadow:var(--card-shadow); border:1rpx solid rgba(26,48,92,0.02); display:flex; align-items:center; gap:16rpx;">
    <icon type="search" size="16" color="#9ca3af"></icon>
    <input 
      class="search-input" 
      style="flex:1; font-size:26rpx; color:var(--text-main); height:50rpx; outline:none;" 
      placeholder="输入项目、时间、金额、供应商、采购项进行搜索..." 
      value="{{searchQuery}}" 
      bindinput="onSearchInput"
    />
    <icon type="clear" size="16" color="#cbd5e1" bindtap="onClearSearch" wx:if="{{searchQuery}}"></icon>
  </view>

  <!-- 过滤 Tab -->
  <view class="filter-tabs">
    <view class="tab-item {{activeTab === 'pending' ? 'active' : ''}}" bindtap="onTabChange" data-tab="pending">
      待确认 ({{stats.pendingCount}})
    </view>
    <view class="tab-item {{activeTab === 'all' ? 'active' : ''}}" bindtap="onTabChange" data-tab="all">
      全部比价单 ({{stats.totalCount}})
    </view>
    <view class="tab-item {{activeTab === 'approved' ? 'active' : ''}}" bindtap="onTabChange" data-tab="approved">
      已归档 ({{stats.approvedCount}})
    </view>
  </view>

  <!-- 列表主区域 -->
  <scroll-view class="list-scroll" scroll-y bindrefresherrefresh="onRefresh" refresher-enabled refresher-triggered="{{refreshing}}">
    
    <!-- 全局系统无数据空状态 -->
    <view class="empty-state" wx:if="{{stats.totalCount === 0}}">
      <view class="empty-icon">📭</view>
      <view class="empty-title">系统内暂无比价单</view>
      <view class="empty-desc">当前暂无数据，请点击下方按钮新建一个比价单并开启审批流程。</view>
      <view class="empty-actions" style="margin-top: 30rpx; display: flex; justify-content: center; width: 100%;">
        <button class="btn-primary" style="font-size: 24rpx; padding: 12rpx 30rpx; height: auto; line-height: 1.5; margin: 0; background-color: #1a305c; color: #ffffff;" bindtap="onCreateNew" wx:if="{{currentUser.role === '采购员'}}">📝 新建比价单</button>
      </view>
    </view>

    <!-- 筛选过滤后的无数据空状态 -->
    <view class="empty-state" wx:elif="{{filteredList.length === 0}}">
      <view class="empty-icon">📭</view>
      <view class="empty-title">暂无相关比价单</view>
      <view class="empty-desc">当前筛选条件下没有任何数据</view>
    </view>

    <view 
      class="card list-card" 
      wx:for="{{filteredList}}" 
      wx:key="id" 
      bindtap="onViewDetail" 
      data-id="{{item.id}}"
      hover-class="hover-item"
    >
      <view class="card-header">
        <view class="card-title-text">{{item.title}}</view>
        <view class="badge badge-{{item.status}}">{{statusTextMap[item.status]}}</view>
      </view>

      <view class="card-body">
        <view class="info-row">
          <text class="label">申请人员：</text>
          <text class="val">{{item.creator}}</text>
        </view>
        <view class="info-row">
          <text class="label">申请时间：</text>
          <text class="val">{{item.createTime}}</text>
        </view>
        <view class="info-row">
          <text class="label">参比厂家：</text>
          <text class="val">{{item.suppliers.length}} 家 ({{item.supplierNamesShort}})</text>
        </view>
        <view class="info-row item-summary">
          <text class="label">采购物资：</text>
          <text class="val">{{item.itemSummaryText}}</text>
        </view>
      </view>

      <view class="card-footer">
        <!-- 如果是需要当前登录用户签名的，高亮显示操作指引 -->
        <view class="action-alert" wx:if="{{item.needMyApproval}}">
          <text class="alert-icon">⚡</text> 需要您签字确认
        </view>
        <view class="view-detail-link" wx:else>点击查看详情 ➔</view>
      </view>
    </view>
  </scroll-view>

  <!-- 采购员专享：悬浮新建按钮 -->
  <view 
    class="float-add-btn" 
    bindtap="onCreateNew" 
    wx:if="{{currentUser.role === '采购员'}}"
    hover-class="hover-btn"
  >
    <text class="add-icon">+</text>
    <text class="add-text">新建比价</text>
  </view>
</view>
