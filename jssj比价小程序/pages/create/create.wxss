.header-banner {
  background: var(--primary-gradient);
  color: #ffffff;
  padding: 40rpx 30rpx;
  border-radius: 24rpx;
  margin-bottom: 30rpx;
  position: relative;
}

.banner-title {
  font-size: 34rpx;
  font-weight: 700;
}

.banner-subtitle {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
}

.autofill-btn {
  position: absolute;
  right: 30rpx;
  top: 40rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.4);
  color: #ffffff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  margin: 0;
  line-height: 1.5;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-muted);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.form-input.disabled {
  background-color: #f3f4f6;
  color: var(--text-muted);
}

.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title-row .card-title {
  margin-bottom: 0;
}

.add-row-btn {
  background-color: var(--success-light);
  color: var(--success-color);
  font-size: 24rpx;
  font-weight: 700;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  margin: 0;
  line-height: 1.5;
  border: 1rpx solid rgba(16, 185, 129, 0.2);
}

.item-row-card {
  background-color: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-color);
}

.item-row-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  border-bottom: 1rpx dashed var(--border-color);
  padding-bottom: 12rpx;
}

.item-index-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.delete-row-link {
  color: var(--danger-color);
  font-size: 24rpx;
  font-weight: 600;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.span-2 {
  grid-column: span 2;
}

.quote-section-title {
  font-size: 24rpx;
  color: var(--text-main);
  font-weight: 700;
  margin-top: 24rpx;
  margin-bottom: 16rpx;
}

.quotes-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.quote-input-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.quote-label-short {
  font-size: 24rpx;
  color: var(--text-muted);
  width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quote-input {
  flex: 1;
}

.clause-group {
  margin-bottom: 30rpx;
}

.clause-group:last-child {
  margin-bottom: 0;
}

.clause-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.clause-inputs {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.clause-input-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.clause-label-short {
  font-size: 24rpx;
  color: var(--text-muted);
  width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.radio-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 10rpx;
}

.radio-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: #f8fafc;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
}

.radio-text {
  font-size: 26rpx;
  color: var(--text-main);
}

.action-bar {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.form-submit-btn {
  width: 100% !important;
  height: 90rpx;
}

.form-cancel-btn {
  width: 100% !important;
  height: 90rpx;
}

/* ================= 智能比价导入与下拉历史样式追加 ================= */
.ocr-card {
  border: 1rpx dashed var(--success-color);
  background-color: #f0fdf4;
}

.ocr-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
}

.ocr-action-btn {
  width: 100% !important;
  font-size: 26rpx !important;
  font-weight: 700 !important;
  height: 84rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  border-radius: 16rpx !important;
  padding: 0 !important;
  margin: 0 !important;
}

.ocr-action-btn.file-btn {
  background-color: #e6f7f0 !important;
  color: var(--success-color) !important;
  border: 1rpx solid rgba(16, 185, 129, 0.2) !important;
}

.ocr-action-btn.paste-btn {
  background-color: #eef2ff !important;
  color: #4f46e5 !important;
  border: 1rpx solid rgba(79, 70, 229, 0.2) !important;
}

.paste-box-wrap {
  margin-top: 24rpx;
  width: 100%;
}

.paste-textarea {
  background-color: #ffffff !important;
  border: 1rpx solid var(--border-color);
  font-size: 26rpx;
  height: 180rpx;
  width: 100%;
}

.history-dropdown-box {
  position: absolute;
  top: 100%;
  left: 0;
  width: 100%;
  background-color: #ffffff;
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  max-height: 280rpx;
  overflow-y: auto;
  z-index: 999;
}

.history-item {
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-main);
  border-bottom: 1rpx solid #f3f4f6;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.history-item:active {
  background-color: #f3f4f6;
}

.history-empty {
  padding: 24rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
}

/* 审批点选按钮池与链条预览 */
.approver-buttons-pool {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.approver-pool-btn {
  background-color: #ffffff !important;
  color: var(--primary-color) !important;
  border: 1rpx solid var(--primary-color) !important;
  font-size: 24rpx !important;
  font-weight: 600 !important;
  padding: 8rpx 20rpx !important;
  height: auto !important;
  line-height: 1.5 !important;
  border-radius: 30rpx !important;
  margin: 0 !important;
}

.path-preview-box {
  background-color: #f8fafc;
  border: 1rpx solid var(--border-color);
  border-radius: 16rpx;
  padding: 20rpx;
}

.path-title {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 12rpx;
}

.path-chain {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.path-node {
  background-color: #e0f2fe;
  color: #0369a1;
  font-size: 24rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(3, 105, 161, 0.1);
}

.path-arrow {
  color: #9ca3af;
  font-size: 22rpx;
}

.path-empty {
  font-size: 24rpx;
  color: var(--warning-color);
  font-weight: 600;
}

/* ================= 报价录入模式切换与公司平铺Tabs ================= */
.fill-mode-toggle .mode-btn {
  background-color: #ffffff;
  border: 1rpx solid #d1d5db;
  color: #4b5563;
  transition: all 0.2s ease;
}

.fill-mode-toggle .mode-btn.active {
  background-color: #1a305c;
  color: #ffffff;
  border-color: #1a305c;
}

.fill-supplier-tabs .fill-sup-tab {
  transition: all 0.2s ease;
}

.fill-supplier-tabs .fill-sup-tab.active {
  background-color: #eff6ff !important;
  border-color: #3b82f6 !important;
  color: #1d4ed8 !important;
  box-shadow: 0 2px 8px rgba(59, 130, 246, 0.1);
}

.approver-pool-btn.selected-approver {
  background-color: #1a305c !important;
  color: #ffffff !important;
  border-color: #1a305c !important;
}
