/* 全局样式表 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif;
  background-color: #f4f6fa;
  color: #333333;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  --primary-color: #1a305c;
  --primary-gradient: linear-gradient(135deg, #1a305c 0%, #2e4d82 100%);
  --success-color: #10b981;
  --success-light: #e6f7f0;
  --warning-color: #f59e0b;
  --warning-light: #fef3c7;
  --danger-color: #ef4444;
  --danger-light: #fee2e2;
  --text-main: #1f2937;
  --text-muted: #6b7280;
  --border-color: #e5e7eb;
  --card-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
}

/* 微信小程序全局盒模型重置 */
view, scroll-view, text, button, input, textarea, form, picker {
  box-sizing: border-box;
}

/* 按钮微交互动画 */
.hover-btn {
  opacity: 0.85;
  transform: scale(0.98);
}

.hover-item {
  background-color: #f9fafb !important;
}

/* 容器布局 */
.container {
  padding: 30rpx;
  min-height: 100vh;
}

/* 卡片样式 */
.card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: var(--card-shadow);
  border: 1px solid rgba(26, 48, 92, 0.03);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-color);
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 审批状态徽章 */
.badge {
  display: inline-block;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 30rpx;
}

.badge-pending_manager {
  background-color: var(--warning-light);
  color: var(--warning-color);
}

.badge-pending_gm {
  background-color: #e0f2fe;
  color: #0284c7;
}

.badge-approved {
  background-color: var(--success-light);
  color: var(--success-color);
}

.badge-rejected {
  background-color: var(--danger-light);
  color: var(--danger-color);
}

/* 输入框通用样式 */
.form-input {
  width: 100%;
  height: 80rpx;
  border: 1px solid var(--border-color);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background-color: #fafbfc;
  transition: all 0.3s;
}

.form-input:focus {
  border-color: var(--primary-color);
  background-color: #ffffff;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  border: 1px solid var(--border-color);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background-color: #fafbfc;
}

/* 按钮通用样式 */
.btn-primary {
  background: var(--primary-gradient);
  color: #ffffff;
  font-weight: 600;
  border-radius: 16rpx;
  font-size: 30rpx;
  box-shadow: 0 4px 12px rgba(26, 48, 92, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: none;
}

.btn-secondary {
  background-color: #ffffff;
  color: var(--primary-color);
  border: 1rpx solid var(--primary-color);
  font-weight: 600;
  border-radius: 16rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 底部安全区 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 提示信息 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* ================= 语音输入与识别 HUD 样式 ================= */
.input-voice-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
}

.input-voice-wrap input {
  flex: 1;
}

.voice-btn {
  width: 76rpx !important;
  height: 76rpx !important;
  border-radius: 50% !important;
  background-color: #f0f4fa !important;
  border: 1rpx solid #d1e2f9 !important;
  color: var(--primary-color) !important;
  font-size: 32rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 !important;
  margin: 0 !important;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(26, 48, 92, 0.05);
}

.voice-btn:active {
  background-color: #e0ecfb !important;
  transform: scale(0.95);
}

/* 语音输入弹出遮罩 */
.voice-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 9999;
  display: none;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(5px);
}

.voice-modal.active {
  display: flex;
}

.voice-modal-content {
  background-color: #ffffff;
  width: 560rpx;
  border-radius: 36rpx;
  padding: 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
  text-align: center;
}

.voice-wave-box {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 100rpx;
  margin-bottom: 30rpx;
}

.voice-wave-bar {
  width: 8rpx;
  height: 30rpx;
  background: var(--primary-gradient);
  border-radius: 4rpx;
  animation: wave 1.2s ease-in-out infinite alternate;
}

.voice-wave-bar.bar-1 { animation-delay: 0.1s; }
.voice-wave-bar.bar-2 { animation-delay: 0.3s; height: 50rpx; }
.voice-wave-bar.bar-3 { animation-delay: 0.5s; height: 70rpx; }
.voice-wave-bar.bar-4 { animation-delay: 0.2s; height: 40rpx; }

@keyframes wave {
  0% { transform: scaleY(0.4); }
  100% { transform: scaleY(1.5); }
}

.voice-status-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.voice-status-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 40rpx;
}

.voice-stop-btn {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 48rpx;
  border-radius: 30rpx;
  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
  border: none;
}
